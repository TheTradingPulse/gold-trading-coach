# ==============================
# The Trading Pulse
# Git Ignore
# ==============================

# Python virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.class

# Environment variables / secrets
.env
.env.*
!.env.example

# API keys / credentials
*.key
*.pem
credentials.json
secrets.json

# Local databases
*.db
*.sqlite
*.sqlite3

# Temporary files
temp/
tmp/
temp_chart.png
*.tmp
*.log

# Local data exports
*.csv

# Screenshots / generated images
screenshots/

# Project backups / archives
*.zip
*.rar
*.7z
*.tar
*.gz

# IDE / editor files
.vscode/
.idea/

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
