# Trading Pulse release-safe ignore policy

# Credentials and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Research warehouses, purchased market data, and generated evidence
research_data/
knowledge/*.db
knowledge/*.db-*
*.db
*.db-journal
*.sqlite
*.sqlite3
*.parquet
*.feather
*.arrow
*.dbn
*.csv.gz

# Backups, installer archives, and generated result packages
backups/
backup/
archive/
archives/
*.zip
*.download
*.tar
*.tar.gz
*.7z

# Generated reports and runtime output
logs/
*.log
tmp/
temp/
output/
outputs/
results/
prepublish_gate_report.json

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# JavaScript tooling if introduced later
node_modules/
dist/
build/
